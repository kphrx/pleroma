<item>
  <guid isPermaLink="true"><%= escape(activity_link(@activity, @data) || "") %></guid>
  <link><%= escape(activity_link(@activity, @data) || "") %></link>
  <pubDate><%= to_rfc2822(@data["published"]) %></pubDate>
  <title><%= activity_title(@data, Keyword.get(@feed_config, :post_title, %{})) %></title>
  <description><%= activity_description(@data) %></description>
  <content:encoded><![CDATA[<%= rss_content_encoded(@data) %>]]></content:encoded>

  <%= unless sensitive?(@data) do %>
    <%= with attachment when not is_nil(attachment) <- rss_enclosure_attachment(@data["attachment"]) do %>
      <enclosure url="<%= escape(attachment_href(attachment) || "") %>" type="<%= escape(attachment_type(attachment) || "application/octet-stream") %>" length="<%= attachment_size_positive(attachment) %>"/>
    <% end %>
  <% end %>

  <%= for attachment <- @data["attachment"] || [] do %>
    <%= media_content_xml(attachment, sensitive?(@data)) %>
  <% end %>

  <%= for tag <- Pleroma.Object.hashtags(@object) do %>
    <%= if tag && tag != "" do %>
      <category><%= tag %></category>
    <% end %>
  <% end %>
</item>
